# =============================================================================
# store-service environment template
# -----------------------------------------------------------------------------
# Usage:
#   cp .env.example .env
#   # edit .env, then:
#   docker compose up -d --build
#
# Gradle bootRun loads ./.env if present (see build.gradle).
# =============================================================================

# -----------------------------------------------------------------------------
# Docker Compose — host port & database (see docker-compose.yml)
# -----------------------------------------------------------------------------
STORE_SERVICE_HOST_PORT=8087
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=store_db

# -----------------------------------------------------------------------------
# Docker profile (application-docker.yml + compose) — required in containers
# -----------------------------------------------------------------------------
# HS256 JWT signing secret (must be strong in production).
JWT_SECRET_KEY=change-this-to-a-long-random-secret-at-least-32-characters

JWT_ISSUER=store-service

# Brokers reachable from the Spring container (required by compose)
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

SWAGGER_ENABLED=true

# Optional: Redis ACL password (leave empty if no auth)
REDIS_PASSWORD=

# Spring Cloud Config (application-docker.yml)
CONFIG_SERVER_ENABLED=false
CONFIG_SERVER_URI=http://config-server:8888

# -----------------------------------------------------------------------------
# Postgres pool (application-docker.yml)
# -----------------------------------------------------------------------------
POSTGRES_MAX_POOL_SIZE=20
POSTGRES_MIN_IDLE=5

# -----------------------------------------------------------------------------
# Observability — logging paths & levels (application-docker.yml, logback)
# -----------------------------------------------------------------------------
SPRING_APPLICATION_NAME=store-service
LOG_PATH=logs

LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_SPRING_WEB=WARN
LOG_LEVEL_SPRING_SECURITY=WARN
LOG_LEVEL_HIBERNATE=WARN
LOG_LEVEL_AUDIT=INFO

LOG_MAX_SIZE=100MB
LOG_MAX_HISTORY=30

AUDIT_DETAILED=false
MANAGEMENT_HEALTH_DETAILS=always

# -----------------------------------------------------------------------------
# JWT lifetimes — docker profile binds minutes (application-docker.yml)
# -----------------------------------------------------------------------------
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_MINUTES=43200

# -----------------------------------------------------------------------------
# Rate limits — optional overrides (application-docker.yml)
# -----------------------------------------------------------------------------
RATE_LIMIT_GLOBAL_MAX=5000
RATE_LIMIT_STANDARD=40
RATE_LIMIT_SENSITIVE=7
RATE_LIMIT_PUBLIC=100
RATE_LIMIT_ADMIN=50
RATE_LIMIT_CUSTOMER_WRITE=20
RATE_LIMIT_CUSTOMER_READ=100

# =============================================================================
# Local dev (default application.yml — spring.profiles.active=dev)
# Not used when SPRING_PROFILES_ACTIVE=docker
# -----------------------------------------------------------------------------
# JWT in application.yml (no default in YAML — set for local runs):
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-characters
ISSUER=drugstore-dev

SERVER_PORT=8080

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# NB: typo in YAML property name remains as-is: product_DB

product_DB=drugstore_products
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
