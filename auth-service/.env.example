# ==========================================================
# Auth Service — Environment Variables
# Copy to .env at this directory (project root) and fill in values.
#
# Docker (run from project root):
#   cp .env.example .env
#   docker compose -f docker/docker-compose.full.yml --env-file .env up -d --build
#   docker compose -f docker/docker-compose.app.yml  --env-file .env up -d --build
#
# Gradle also reads this file for GitHub Packages credentials.
# ==========================================================

# --- Required ---
JWT_SECRET_KEY=change_me_super_long_random_secret
GITHUB_ACTOR=your_github_username
GITHUB_TOKEN=ghp_your_personal_access_token

# --- Compose profile (local | prod) ---
COMPOSE_PROFILES=local

# --- Spring / Docker runtime ---
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080
JWT_ISSUER=drugstore-api

# --- Redis (required) ---
# Full stack local: redis://redis:6379
# App-only on host: redis://host.docker.internal:6379
# With password: redis://:yourpassword@your-host:6379
REDIS_URL=redis://redis:6379

# --- Kafka (required) ---
# Full stack local: brokers on drugstore-kafka-network (start ../../infrastrucuture/kafka first)
# App-only on host: host.docker.internal:9093
# Production: cloud MSK / Confluent bootstrap servers
KAFKA_BOOTSTRAP_SERVERS=kafka-1:9092,kafka-2:9092,kafka-3:9092

# --- gRPC client → user-service (required) ---
# Full stack local: user-service (Docker DNS)
# App-only on host: host.docker.internal
# Production: internal DNS / service mesh hostname
GRPC_CLIENT_USER_SERVICE_HOST=user-service
GRPC_CLIENT_USER_SERVICE_PORT=9090

# --- Google OAuth2 (optional for local dev without social login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: Redis pool ---
# REDIS_POOL_MAX_ACTIVE=20
# REDIS_POOL_MAX_IDLE=10
# REDIS_POOL_MIN_IDLE=5

# --- Optional: application tuning ---
SWAGGER_ENABLED=true
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_ROOT=WARN
JAVA_OPTS=-Xmx512m -Xms256m

# --- Optional: JWT token lifetimes (minutes) ---
# JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
# JWT_REFRESH_TOKEN_EXPIRATION_MINUTES=43200

# --- Optional: rate limits ---
# RATE_LIMIT_GLOBAL_MAX=5000
# RATE_LIMIT_STANDARD=40
# RATE_LIMIT_SENSITIVE=7
# RATE_LIMIT_PUBLIC=100
# RATE_LIMIT_ADMIN=50
# RATE_LIMIT_CUSTOMER_WRITE=20
# RATE_LIMIT_CUSTOMER_READ=100

# --- Optional: logging ---
# LOG_PATH=/app/logs
# LOG_MAX_SIZE=100MB
# LOG_MAX_HISTORY=30
# LOG_LEVEL_SPRING_WEB=WARN
# LOG_LEVEL_SPRING_SECURITY=WARN
# LOG_LEVEL_HIBERNATE=WARN
# LOG_LEVEL_AUDIT=INFO
# AUDIT_DETAILED=false

# --- Optional: management / config server ---
# MANAGEMENT_HEALTH_DETAILS=never
# CONFIG_SERVER_ENABLED=false
# CONFIG_SERVER_URI=http://config-server:8888

# --- Full stack only: host port mappings (avoid conflicts with other services) ---
AUTH_HOST_PORT=8082
REDIS_HOST_PORT=6378
PROMETHEUS_HOST_PORT=9090
LOKI_HOST_PORT=3100
GRAFANA_HOST_PORT=3000

# --- Full stack only: Grafana admin (local monitoring) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Production overrides (set COMPOSE_PROFILES=prod and update URLs) ---
# REDIS_URL=redis://:replace_if_auth_enabled@your-redis-host.cache.amazonaws.com:6379
# KAFKA_BOOTSTRAP_SERVERS=b-1.your-cluster.kafka.amazonaws.com:9092,b-2.your-cluster.kafka.amazonaws.com:9092
# GRPC_CLIENT_USER_SERVICE_HOST=user-service.internal.example.com
# GRPC_CLIENT_USER_SERVICE_PORT=9090
# SWAGGER_ENABLED=false
# LOG_LEVEL_APP=INFO
# JAVA_OPTS=-Xmx768m -Xms512m -XX:+UseG1GC

# --- App-only local profile: point to host or external infra ---
# REDIS_URL=redis://host.docker.internal:6379
# KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9093
# GRPC_CLIENT_USER_SERVICE_HOST=host.docker.internal
# GRPC_CLIENT_USER_SERVICE_PORT=9090
