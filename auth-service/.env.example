# auth-service environment template
# Copy to `.env` in this directory (alongside docker-compose.yml).
# Compose interpolates REDIS_PASSWORD; the stack passes additional vars via `env_file: .env`.

# -----------------------------------------------------------------------------
# Required when running with Spring profile `docker` (JWT signing)
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=change_me_use_long_random_secret

# -----------------------------------------------------------------------------
# Google OAuth2 (spring.security.oauth2.client.registration.google — no defaults in YAML)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Redis (application.yml / application.docker.yml / compose)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Pool sizing — docker profile only (defaults shown)
# REDIS_POOL_MAX_ACTIVE=20
# REDIS_POOL_MAX_IDLE=10
# REDIS_POOL_MIN_IDLE=5

# -----------------------------------------------------------------------------
# Kafka
# -----------------------------------------------------------------------------
# Local JVM / IDE: host-published broker (kafka-1 PLAINTEXT_HOST on :9093)
KAFKA_BOOTSTRAP_SERVERS=localhost:9093
# Docker Compose overrides this to kafka-1:9092,kafka-2:9092,kafka-3:9092 (see docker-compose.yml).
# Start the cluster first: cd ../infrastrucuture/kafka && docker compose up -d

# -----------------------------------------------------------------------------
# JWT tuning (defaults in parentheses)
# -----------------------------------------------------------------------------
# JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
# JWT_REFRESH_TOKEN_EXPIRATION_MINUTES=43200
# JWT_ISSUER=drugstore-prod

# -----------------------------------------------------------------------------
# Spring Cloud Config (docker profile)
# -----------------------------------------------------------------------------
# CONFIG_SERVER_ENABLED=false
# CONFIG_SERVER_URI=http://config-server:8888

# -----------------------------------------------------------------------------
# API docs — docker profile
# -----------------------------------------------------------------------------
# SWAGGER_ENABLED=false

# -----------------------------------------------------------------------------
# Rate limiting — docker profile (see application.docker.yml for defaults)
# -----------------------------------------------------------------------------
# RATE_LIMIT_GLOBAL_MAX=5000
# RATE_LIMIT_STANDARD=40
# RATE_LIMIT_SENSITIVE=7
# RATE_LIMIT_PUBLIC=100
# RATE_LIMIT_ADMIN=50
# RATE_LIMIT_CUSTOMER_WRITE=20
# RATE_LIMIT_CUSTOMER_READ=100

# -----------------------------------------------------------------------------
# Logging / audit / actuator — docker profile & logback-spring.xml
# -----------------------------------------------------------------------------
# SPRING_APPLICATION_NAME=auth-service
# LOG_PATH=/app/logs
# LOG_MAX_SIZE=100MB
# LOG_MAX_HISTORY=30
# LOG_LEVEL_ROOT=WARN
# LOG_LEVEL_APP=INFO
# LOG_LEVEL_SPRING_WEB=WARN
# LOG_LEVEL_SPRING_SECURITY=WARN
# LOG_LEVEL_HIBERNATE=WARN
# LOG_LEVEL_AUDIT=INFO
# AUDIT_DETAILED=false
# MANAGEMENT_HEALTH_DETAILS=never

# -----------------------------------------------------------------------------
# gRPC client → user-service (defaults: localhost:9090 — relaxed binding from YAML keys)
# -----------------------------------------------------------------------------
# GRPC_CLIENT_USER_SERVICE_HOST=localhost
# GRPC_CLIENT_USER_SERVICE_PORT=9090
# GRPC_CLIENT_USER_SERVICE_KEEP_ALIVE_TIME=30
# GRPC_CLIENT_USER_SERVICE_KEEP_ALIVE_TIMEOUT=5
# GRPC_CLIENT_USER_SERVICE_IDLE_TIMEOUT=60
# GRPC_CLIENT_USER_SERVICE_MAX_INBOUND_MESSAGE_SIZE=4194304

# -----------------------------------------------------------------------------
# OAuth redirect after login (OAuth2AuthenticationSuccessHandler default)
# -----------------------------------------------------------------------------
# OAUTH2_REDIRECT_URL=http://localhost:3000/oauth2/redirect

# -----------------------------------------------------------------------------
# Activation / 2FA token lengths & TTLs (Java defaults apply if unset)
# -----------------------------------------------------------------------------
# TOKEN_ACTIVATION_LENGTH=6
# TOKEN_TWO_FA_LENGTH=6
# TOKEN_ACTIVATION_EXPIRATION_MINUTES=15
# TOKEN_TWO_FA_EXPIRATION_MINUTES=5

# -----------------------------------------------------------------------------
# Local runs / tooling (compose sets these inline; override only if needed)
# -----------------------------------------------------------------------------
# SPRING_PROFILES_ACTIVE=docker
# JAVA_OPTS=-Xmx512m -Xms256m

# Grafana in docker-compose.yml uses GF_SECURITY_ADMIN_USER/PASSWORD (currently admin/admin in YAML).

# -----------------------------------------------------------------------------
# Github Package
# -----------------------------------------------------------------------------

GITHUB_ACTOR=username...
GITHUB_TOKEN=ghp_...