# ==========================================================
# Auth Service — shared Docker environment variables
# Copy to docker/.env and fill in required values.
# Profile-specific overrides live in .env.local / .env.prod.
# ==========================================================

# --- Required — JWT signing (≥32 characters for HS256) ---
JWT_SECRET_KEY=change_me_use_long_random_secret

# --- GitHub Packages (Gradle dependency resolution during image build) ---
GITHUB_ACTOR=your_github_username
GITHUB_TOKEN=ghp_your_personal_access_token

# --- Google OAuth2 (optional for local dev without social login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
