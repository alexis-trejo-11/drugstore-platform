# ==========================================================
# Production profile — external managed cloud infrastructure
# Usage:
#   cp .env.example .env
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.full.yml --profile prod --env-file .env --env-file .env.prod up -d --build
#   docker compose -f docker-compose.app.yml  --profile prod --env-file .env --env-file .env.prod up -d --build
# ==========================================================

COMPOSE_PROFILES=prod

# --- Managed Redis (e.g. AWS ElastiCache, Memorystore, Azure Cache) ---
REDIS_HOST=your-redis-host.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=replace_if_auth_enabled

# --- Managed Kafka (e.g. AWS MSK, Confluent Cloud) ---
KAFKA_BOOTSTRAP_SERVERS=b-1.your-cluster.kafka.amazonaws.com:9092,b-2.your-cluster.kafka.amazonaws.com:9092

# --- user-service gRPC endpoint (cloud / internal DNS) ---
GRPC_CLIENT_USER_SERVICE_HOST=user-service.internal.example.com
GRPC_CLIENT_USER_SERVICE_PORT=9090

# --- Application (production defaults) ---
SWAGGER_ENABLED=false
LOG_LEVEL_APP=INFO
JAVA_OPTS=-Xmx768m -Xms512m -XX:+UseG1GC

# --- Optional: stricter rate limits / JWT (override in .env) ---
# JWT_SECRET_KEY=
# RATE_LIMIT_GLOBAL_MAX=5000
