# ==========================================================
# Local profile — bundled containers (full stack) or host services (app only)
# Usage:
#   cp .env.example .env
#   cp .env.local.example .env.local
#   docker compose -f docker-compose.full.yml --profile local --env-file .env --env-file .env.local up -d --build
# ==========================================================

COMPOSE_PROFILES=local

# --- Redis (full stack: Docker service name "redis") ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Kafka (full stack: brokers on drugstore-kafka-network) ---
# Start the cluster first: cd ../../infrastrucuture/kafka && docker compose up -d
KAFKA_BOOTSTRAP_SERVERS=kafka-1:9092,kafka-2:9092,kafka-3:9092

# --- gRPC client → user-service (full stack: Docker DNS name) ---
GRPC_CLIENT_USER_SERVICE_HOST=user-service
GRPC_CLIENT_USER_SERVICE_PORT=9090

# --- Host port mappings (full stack only, avoid conflicts with other services) ---
AUTH_HOST_PORT=8082
REDIS_HOST_PORT=6378
PROMETHEUS_HOST_PORT=9090
LOKI_HOST_PORT=3100
GRAFANA_HOST_PORT=3000

# --- Application tuning ---
SERVER_PORT=8080
SWAGGER_ENABLED=true
LOG_LEVEL_APP=DEBUG
JAVA_OPTS=-Xmx512m -Xms256m

# --- Grafana (local monitoring stack) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- App-only local profile: point to host or external infra ---
# Uncomment when using docker-compose.app.yml against host-installed Redis/Kafka:
# REDIS_HOST=host.docker.internal
# REDIS_PORT=6379
# KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9093
# GRPC_CLIENT_USER_SERVICE_HOST=host.docker.internal
# GRPC_CLIENT_USER_SERVICE_PORT=9090
