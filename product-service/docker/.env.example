# ==========================================================
# Product Service — shared Docker environment variables
# Copy to docker/.env and fill in required values.
# Profile-specific overrides live in .env.local / .env.prod.
# ==========================================================

# --- Required — JWT signing (≥32 characters for HS256) ---
JWT_SECRET_KEY=replace-with-your-own-secret-at-least-32-characters-long
JWT_ISSUER=product-service
