# ==========================================================
# Local profile — bundled containers (full stack) or host services (app only)
# Usage:
#   cp .env.example .env
#   cp .env.local.example .env.local
#   docker compose -f docker-compose.full.yml --profile local --env-file .env --env-file .env.local up -d --build
# ==========================================================

COMPOSE_PROFILES=local

# --- Database (full stack: Docker service name "postgres") ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DB_NAME=inventory_db
DB_USER=postgres
DB_PASSWORD=change-me

# --- Redis (full stack: Docker service name "redis") ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Host port mappings (full stack only, avoid conflicts with other services) ---
INVENTORY_HOST_PORT=8084
POSTGRES_HOST_PORT=5431
REDIS_HOST_PORT=6378
PROMETHEUS_HOST_PORT=9090
LOKI_HOST_PORT=3100
GRAFANA_HOST_PORT=3000

# --- Application tuning ---
SERVER_PORT=8080
SWAGGER_ENABLED=true
JAVA_OPTS=-Xmx512m -Xms256m

# --- Observability (local monitoring stack) ---
LOKI_PUSH_URL=http://loki:3100/loki/api/v1/push
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# --- App-only local profile: point to host or full-stack infra ---
# Uncomment when using docker-compose.app.yml against host-installed Postgres/Redis:
# POSTGRES_HOST=host.docker.internal
# REDIS_HOST=host.docker.internal
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# LOKI_PUSH_URL=http://host.docker.internal:3100/loki/api/v1/push
