# ==========================================================
# Inventory Service — shared Docker environment variables
# Copy to docker/.env and fill in required values.
# Profile-specific overrides live in .env.local / .env.prod.
# ==========================================================

# --- Required — JWT signing (≥32 characters for HS256) ---
JWT_SECRET=replace-with-your-own-secret-at-least-32-characters-long
ISSUER=inventory-service
