# =============================================================================
# Local Docker / Compose — copy to `.env` and set real values.
#   cp .env.example .env
# Compose reads `.env` for `${VAR}` substitution and passes it into containers.
# `.env` is gitignored; keep secrets and environment-specific values only there.
# =============================================================================

# ---- Published host port (maps ${INVENTORY_HOST_PORT}:8080 in the container)
INVENTORY_HOST_PORT=8084

# ---- Spring (inside container)
SPRING_APPLICATION_NAME=inventory-service
SERVER_PORT=8080

# ---- PostgreSQL (Spring datasource + postgres service; use same DB_NAME/USER/PASSWORD)
# docker-compose maps DB_USER/DB_PASSWORD → POSTGRES_USER/POSTGRES_PASSWORD for Spring JDBC.
DB_NAME=inventory_db
DB_USER=postgres
DB_PASSWORD=change-me

POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# ---- JWT (HS256: use at least 32 bytes; generate a strong secret for any shared env)
JWT_SECRET=replace-with-your-own-secret-at-least-32-characters-long
ISSUER=inventory-service
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_MINUTES=43200

# ---- Observability / UI
LOKI_PUSH_URL=http://loki:3100/loki/api/v1/push
SWAGGER_ENABLED=true

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
