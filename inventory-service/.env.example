# ==========================================================
# Inventory Service — Environment Variables
# Copy to .env at this directory (project root) and fill in values.
#
# Docker (run from project root):
#   cp .env.example .env
#   docker compose -f docker/docker-compose.full.yml --env-file .env up -d --build
#   docker compose -f docker/docker-compose.app.yml  --env-file .env up -d --build
#
# Gradle also reads this file for local bootRun.
# ==========================================================

# --- Required ---
JWT_SECRET_KEY=change_me_super_long_random_secret
GITHUB_ACTOR=your_github_username
GITHUB_TOKEN=ghp_your_personal_access_token

# --- Compose profile (local | prod) ---
COMPOSE_PROFILES=local

# --- Spring / Docker runtime ---
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080
JWT_ISSUER=inventory-service

# --- Database (required) ---
# Full stack local: jdbc:postgresql://postgres:5432/inventory_db
# App-only on host: jdbc:postgresql://host.docker.internal:5432/inventory_db
# Production: jdbc:postgresql://your-host:5432/your_db
DATASOURCE_URL=jdbc:postgresql://postgres:5432/inventory_db
DB_USER=postgres
DB_PASSWORD=postgres

# Full stack only: bundled Postgres container init (local profile)
DB_NAME=inventory_db

# --- Redis (required) ---
# Full stack local: redis://redis:6379
# App-only on host: redis://host.docker.internal:6379
# With password: redis://:yourpassword@your-host:6379
REDIS_URL=redis://redis:6379

# --- Optional: database pool ---
# DB_MAX_POOL_SIZE=20
# DB_MIN_IDLE=5

# --- Optional: Redis pool ---
# REDIS_POOL_MAX_ACTIVE=20
# REDIS_POOL_MAX_IDLE=10
# REDIS_POOL_MIN_IDLE=5

# --- Optional: application tuning ---
SWAGGER_ENABLED=true
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_ROOT=WARN
JAVA_OPTS=-Xmx512m -Xms256m

# --- Optional: JWT token lifetimes (minutes) ---
# JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
# JWT_REFRESH_TOKEN_EXPIRATION_MINUTES=43200

# --- Optional: rate limits ---
# RATE_LIMIT_GLOBAL_MAX=5000
# RATE_LIMIT_STANDARD=40
# RATE_LIMIT_SENSITIVE=7
# RATE_LIMIT_PUBLIC=100
# RATE_LIMIT_ADMIN=50
# RATE_LIMIT_CUSTOMER_WRITE=20
# RATE_LIMIT_CUSTOMER_READ=100

# --- Optional: logging / Loki ---
# LOG_PATH=/app/logs
# LOG_MAX_SIZE=100MB
# LOG_MAX_HISTORY=30
# LOG_LEVEL_SPRING_WEB=WARN
# LOG_LEVEL_SPRING_SECURITY=WARN
# LOG_LEVEL_HIBERNATE=WARN
# LOG_LEVEL_AUDIT=INFO
# AUDIT_DETAILED=false
# LOKI_PUSH_URL=http://loki:3100/loki/api/v1/push

# --- Optional: management / config server ---
# MANAGEMENT_HEALTH_DETAILS=always
# CONFIG_SERVER_ENABLED=false
# CONFIG_SERVER_URI=http://config-server:8888

# --- Full stack only: host port mappings (avoid conflicts with other services) ---
INVENTORY_HOST_PORT=8084
POSTGRES_HOST_PORT=5431
REDIS_HOST_PORT=6378
PROMETHEUS_HOST_PORT=9090
LOKI_HOST_PORT=3100
GRAFANA_HOST_PORT=3000

# --- Full stack only: Grafana admin (local monitoring) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Production overrides (set COMPOSE_PROFILES=prod and update URLs) ---
# DATASOURCE_URL=jdbc:postgresql://your-postgres-host.rds.amazonaws.com:5432/inventory_db
# DB_USER=inventory_service
# DB_PASSWORD=replace_with_secure_password
# REDIS_URL=redis://:replace_if_auth_enabled@your-redis-host.cache.amazonaws.com:6379
# LOKI_PUSH_URL=https://logs-prod.example.grafana.net/loki/api/v1/push
# SWAGGER_ENABLED=false
# LOG_LEVEL_APP=INFO
# JAVA_OPTS=-Xmx768m -Xms512m -XX:+UseG1GC
