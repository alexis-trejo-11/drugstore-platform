# ==========================================================
# Notification Service — Environment Variables
# Copy to .env at this directory (project root) and fill in values.
#
# Docker (from this directory):
#   cp .env.example .env
#   docker compose up -d --build
#   # Full guide: docs/docker-local-dev.md (repo root)
#

# Gradle also reads this file for bootRun.
# ==========================================================

# --- Required ---
JWT_SECRET_KEY=change_me_super_long_random_secret

# --- App container joins external networks; infra is shared outside this repo ---

# --- Spring / Docker runtime ---
# docker         → application-docker.yml (defaults: bundled service hostnames)

SPRING_PROFILES_ACTIVE=docker
NOTIFICATION_SERVICE_PORT=8093
JWT_ISSUER=drugstore-api

# --- MongoDB (required) ---
# Shared infra hostname (example): jdbc:postgresql://postgres_central:5432/your_db
# App-only on host: mongodb://host.docker.internal:27017/notification_db
# Production: mongodb+srv://user:password@cluster.mongodb.net/notification_db
MONGODB_URI=mongodb://mongodb:27017/notification_db
MONGODB_DATABASE=notification_db

# --- Kafka (required) ---
# Shared infra hostname (example): jdbc:postgresql://postgres_central:5432/your_db
# App-only on host: host.docker.internal:9093
# Production: b-1.your-cluster.kafka.amazonaws.com:9092,b-2.your-cluster.kafka.amazonaws.com:9092
KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9092

# --- Email (Gmail SMTP) — optional for local dev ---
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# --- SMS (Twilio) — optional for local dev ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_ENABLED=false

# --- Optional: application tuning ---
LOG_LEVEL_APP=DEBUG
MONGODB_LOG_LEVEL=INFO
JAVA_OPTS=-Xmx512m -Xms256m

# --- Optional: JWT token lifetimes (minutes) ---
# JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
# JWT_REFRESH_TOKEN_EXPIRATION_MINUTES=43200

# --- Optional: notification retry ---
# NOTIFICATION_RETRY_MAX_ATTEMPTS=3
# NOTIFICATION_RETRY_BACKOFF_MS=5000
# NOTIFICATION_EMAIL_FROM_NAME=Drugstore Notifications
# NOTIFICATION_EMAIL_REPLY_TO=noreply@drugstore.com

# --- Optional: logging / Loki ---
# Docker full stack:  http://loki:3100/loki/api/v1/push
# Local Loki on host: http://localhost:3100/loki/api/v1/push
# AWS / Grafana Cloud: https://logs-prod-xxx.grafana.net/loki/api/v1/push
LOKI_PUSH_URL=http://loki:3100/loki/api/v1/push
# LOKI_ENV=local|docker|prod

# --- Optional: logging ---
# bootRun defaults to ./logs; Docker sets LOG_PATH=/app/logs via compose. Override only if needed.
# LOG_PATH=./logs
# LOG_LEVEL_ROOT=WARN
# MANAGEMENT_HEALTH_DETAILS=always

# --- Optional: config server ---
# CONFIG_SERVER_ENABLED=false
# CONFIG_SERVER_URI=http://config-server:8888

# --- Full stack only: host port mappings (avoid conflicts with other services) ---
MONGODB_HOST_PORT=27018
NGINX_HTTP_PORT=8090
NGINX_HTTPS_PORT=8091
PROMETHEUS_HOST_PORT=9093
LOKI_HOST_PORT=3101
GRAFANA_HOST_PORT=3001

# --- Full stack only: Grafana admin (local monitoring) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Production / shared-infra overrides (set cloud or central host URLs in .env) ---
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/notification_db
# KAFKA_BOOTSTRAP_SERVERS=b-1.your-cluster.kafka.amazonaws.com:9092,b-2.your-cluster.kafka.amazonaws.com:9092
# LOG_LEVEL_APP=INFO
# MONGODB_LOG_LEVEL=WARN
# TWILIO_ENABLED=true
# JAVA_OPTS=-Xmx768m -Xms512m -XX:+UseG1GC
