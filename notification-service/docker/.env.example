# ==========================================================
# Notification Service — shared Docker environment variables
# Copy to docker/.env and fill in required values.
# Profile-specific overrides live in .env.local / .env.prod.
# ==========================================================

# --- Required — JWT validation (≥32 characters for HS256) ---
JWT_SECRET_KEY=change_me_use_long_random_secret

# --- Email (Gmail SMTP app password) ---
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# --- SMS (Twilio) — optional for local dev ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_ENABLED=false
