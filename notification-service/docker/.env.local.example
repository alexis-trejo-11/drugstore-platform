# ==========================================================
# Local profile — bundled containers (full stack) or host services (app only)
# Usage:
#   cp .env.example .env
#   cp .env.local.example .env.local
#   docker compose -f docker-compose.full.yml --profile local --env-file .env --env-file .env.local up -d --build
# ==========================================================

COMPOSE_PROFILES=local

# --- MongoDB (full stack: Docker service name "mongodb") ---
MONGODB_URI=mongodb://mongodb:27017/notification_db
MONGODB_DATABASE=notification_db

# --- Kafka (full stack: brokers on drugstore-kafka-network) ---
# Start the cluster first: cd ../../infrastructure/kafka && docker compose up -d
KAFKA_BOOTSTRAP_SERVERS=kafka-1:9092,kafka-2:9092,kafka-3:9092

# --- Host port mappings (avoid conflicts with other Drugstore services) ---
NOTIFICATION_HOST_PORT=8093
MONGODB_HOST_PORT=27018
NGINX_HTTP_PORT=8090
NGINX_HTTPS_PORT=8091
PROMETHEUS_HOST_PORT=9093
LOKI_HOST_PORT=3101
GRAFANA_HOST_PORT=3001

# --- Application tuning ---
LOG_LEVEL_APP=DEBUG
MONGODB_LOG_LEVEL=INFO
JAVA_OPTS=-Xmx512m -Xms256m

# --- Grafana (local monitoring stack) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- App-only local profile: point to host or external infra ---
# Uncomment when using docker-compose.app.yml against host-installed MongoDB/Kafka:
# MONGODB_URI=mongodb://host.docker.internal:27017/notification_db
# KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9093
