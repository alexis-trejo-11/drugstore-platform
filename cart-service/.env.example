# =============================================================================
# cart-service environment template
# -----------------------------------------------------------------------------
# Usage:
#   cp .env.example .env
#   # edit .env, then:
#   docker compose up -d --build
#
# Gradle bootRun loads ./.env if present (see build.gradle).
# Spring binds these vars via ${VAR} placeholders in application*.yml.
# =============================================================================

# -----------------------------------------------------------------------------
# GitHub Packages (Gradle + Docker build — required for shared-kernel dependency)
# -----------------------------------------------------------------------------
GITHUB_ACTOR=your_github_username
GITHUB_TOKEN=ghp_your_personal_access_token

# -----------------------------------------------------------------------------
# Required — JWT signing (both local and docker profiles)
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=change-this-to-a-long-random-secret-at-least-32-characters
ISSUER=drugstore-dev
JWT_ISSUER=drugstore-prod

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
SERVER_PORT=8080
GRPC_SERVER_PORT=9091

# -----------------------------------------------------------------------------
# Database — local dev (application.yml)
# Defaults target a local Postgres; when using compose postgres from the host use DB_PORT=5433.
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=drugstore_carts
DB_USERNAME=postgres
DB_PASSWORD=postgres

# -----------------------------------------------------------------------------
# Database — docker profile (application-docker.yml + compose postgres service)
# Compose also reads DB_USER / DB_PASSWORD for the postgres container.
# -----------------------------------------------------------------------------
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=cart_db
DB_USER=postgres

# Pool sizing — docker profile only
DB_MAX_POOL_SIZE=20
DB_MIN_IDLE=5

# -----------------------------------------------------------------------------
# Redis (application.yml / application-docker.yml)
# Compose maps host port 6378 → container 6379 for local access.
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

REDIS_POOL_MAX_ACTIVE=20
REDIS_POOL_MAX_IDLE=10
REDIS_POOL_MIN_IDLE=5

# -----------------------------------------------------------------------------
# Kafka
# Local JVM: host-published broker (default localhost:9092).
# Docker Compose overrides to kafka-1:9092,kafka-2:9092,kafka-3:9092 inline.
# Start the cluster first: cd ../infrastrucuture/kafka && docker compose up -d
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=cart-service-group

# -----------------------------------------------------------------------------
# JWT lifetimes (minutes)
# -----------------------------------------------------------------------------
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_MINUTES=43200

# -----------------------------------------------------------------------------
# Spring Cloud Config — docker profile
# -----------------------------------------------------------------------------
CONFIG_SERVER_ENABLED=false
CONFIG_SERVER_URI=http://config-server:8888

# -----------------------------------------------------------------------------
# API docs
# Local default: enabled. Docker profile default: disabled (override with true for staging).
# -----------------------------------------------------------------------------
SWAGGER_ENABLED=true

# -----------------------------------------------------------------------------
# JPA — local dev tuning
# -----------------------------------------------------------------------------
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# -----------------------------------------------------------------------------
# Rate limits — optional overrides (application.yml / application-docker.yml)
# -----------------------------------------------------------------------------
RATE_LIMIT_GLOBAL_ENABLED=true
RATE_LIMIT_GLOBAL_MAX=5000
RATE_LIMIT_STANDARD=40
RATE_LIMIT_SENSITIVE=7
RATE_LIMIT_PUBLIC=100
RATE_LIMIT_ADMIN=50
RATE_LIMIT_CUSTOMER_WRITE=20
RATE_LIMIT_CUSTOMER_READ=100

# -----------------------------------------------------------------------------
# Observability — logging paths & levels (application-docker.yml, logback-spring.xml)
# -----------------------------------------------------------------------------
SPRING_APPLICATION_NAME=cart-service
LOG_PATH=logs

LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SPRING_WEB=WARN
LOG_LEVEL_SPRING_SECURITY=WARN
LOG_LEVEL_HIBERNATE=WARN
LOG_LEVEL_AUDIT=INFO

LOG_MAX_SIZE=100MB
LOG_MAX_HISTORY=30

AUDIT_LOG_ENABLED=true
AUDIT_DETAILED=false
MANAGEMENT_HEALTH_DETAILS=always

# -----------------------------------------------------------------------------
# Docker Compose runtime (set inline in compose; override only if needed)
# -----------------------------------------------------------------------------
# SPRING_PROFILES_ACTIVE=docker
# JAVA_OPTS=-Xmx512m -Xms256m
