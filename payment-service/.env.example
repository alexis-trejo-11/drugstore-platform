# ==========================================================
# Payment Service — Environment Variables
# Copy to .env at this directory (project root) and fill in values.
#
# Docker (run from project root):
#   cp .env.example .env
#   docker compose -f docker/docker-compose.full.yml --env-file .env up -d --build
#   docker compose -f docker/docker-compose.app.yml  --env-file .env up -d --build
#
# Gradle also reads this file for local bootRun.
# ==========================================================

# --- Required — Stripe ---
STRIPE_API_KEY=sk_test_replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret

# --- Compose profile (local | prod) ---
COMPOSE_PROFILES=local

# --- Spring / Docker runtime ---
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080
LOG_PATH=/app/logs

# --- Database (required) ---
# Full stack local: jdbc:postgresql://postgres:5432/drugstore_payments
# App-only on host: jdbc:postgresql://host.docker.internal:5432/drugstore_payments
# Production: jdbc:postgresql://your-host:5432/your_db
DATASOURCE_URL=jdbc:postgresql://postgres:5432/drugstore_payments
DB_USER=postgres
DB_PASSWORD=postgres

# Full stack only: bundled Postgres container init (local profile)
DB_NAME=drugstore_payments

# --- Redis (required) ---
# Full stack local: redis://redis:6379
# App-only on host: redis://host.docker.internal:6379
# With password: redis://:yourpassword@your-host:6379
REDIS_URL=redis://redis:6379

# --- Optional: database pool ---
# DB_MAX_POOL_SIZE=10
# DB_MIN_IDLE=2

# --- Optional: Redis pool ---
# REDIS_POOL_MAX_ACTIVE=20
# REDIS_POOL_MAX_IDLE=10
# REDIS_POOL_MIN_IDLE=5

# --- Optional: application tuning ---
SWAGGER_ENABLED=true
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_ROOT=WARN
JAVA_OPTS=-Xmx512m -Xms256m

# --- Optional: logging ---
# LOG_MAX_SIZE=100MB
# LOG_MAX_HISTORY=30
# LOG_LEVEL_SPRING_WEB=WARN
# LOG_LEVEL_HIBERNATE=WARN

# --- Optional: observability ---
# LOKI_PUSH_URL=http://loki:3100/loki/api/v1/push

# --- Full stack only: host port mappings (avoid conflicts with other services) ---
PAYMENT_SERVICE_HOST_PORT=8085
POSTGRES_HOST_PORT=5435
REDIS_HOST_PORT=6385
PROMETHEUS_HOST_PORT=9090
LOKI_HOST_PORT=3100
GRAFANA_HOST_PORT=3000

# --- Full stack only: Grafana admin (local monitoring) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# --- Production overrides (set COMPOSE_PROFILES=prod and update URLs) ---
# DATASOURCE_URL=jdbc:postgresql://your-postgres-host.rds.amazonaws.com:5432/drugstore_payments
# DB_USER=payment_service
# DB_PASSWORD=replace_with_secure_password
# REDIS_URL=redis://:replace_if_auth_enabled@your-redis-host.cache.amazonaws.com:6379
# STRIPE_API_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SWAGGER_ENABLED=false
# LOG_LEVEL_APP=INFO
# JAVA_OPTS=-Xmx768m -Xms512m -XX:+UseG1GC
# LOKI_PUSH_URL=https://logs-prod-xxx.grafana.net/loki/api/v1/push
