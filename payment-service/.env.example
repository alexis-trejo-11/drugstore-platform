# ==========================================================
# Payment Service — Environment Variables
# Copy to .env at this directory (project root) and fill in values.
#
# Docker (from this directory):
#   cp .env.example .env
#   docker compose up -d --build
#   # Full guide: docs/docker-local-dev.md (repo root)
#

# Gradle also reads this file for local bootRun and GitHub Packages credentials.
# ==========================================================

# --- Required — GitHub Packages (shared-kernel) ---
GITHUB_ACTOR=your_github_username
GITHUB_TOKEN=ghp_your_personal_access_token

# --- Required — Stripe ---
STRIPE_API_KEY=sk_test_replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret

# --- App container joins external networks; infra is shared outside this repo ---

# --- Spring / Docker runtime ---
# docker         → application-docker.yml (defaults: bundled service hostnames)

SPRING_PROFILES_ACTIVE=docker
PAYMENT_SERVICE_PORT=8085

# --- Database (required) ---
# Shared infra hostname (example): jdbc:postgresql://postgres_central:5432/your_db
# App-only on host: jdbc:postgresql://host.docker.internal:5432/drugstore_payments
# Production: jdbc:postgresql://your-host:5432/your_db
DATASOURCE_URL=jdbc:postgresql://postgres:5432/drugstore_payments
DB_USER=postgres
DB_PASSWORD=postgres

DB_NAME=drugstore_payments

# --- Redis (required) ---
# Shared infra hostname (example): jdbc:postgresql://postgres_central:5432/your_db
# App-only on host: redis://host.docker.internal:6379
# With password: redis://:yourpassword@your-host:6379
REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=drugstore:payment:

# --- Optional: database pool ---
# DB_MAX_POOL_SIZE=10
# DB_MIN_IDLE=2

# --- Optional: Redis pool ---
# REDIS_POOL_MAX_ACTIVE=20
# REDIS_POOL_MAX_IDLE=10
# REDIS_POOL_MIN_IDLE=5

# --- Optional: application tuning ---
SWAGGER_ENABLED=true
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_ROOT=WARN
JAVA_OPTS=-Xmx512m -Xms256m

# --- Optional: logging ---
# LOG_LEVEL_SPRING_WEB=WARN
# LOG_LEVEL_HIBERNATE=WARN

# --- Optional: observability ---

# --- Full stack only: Grafana admin (local monitoring) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# --- Production / shared-infra overrides (set cloud or central host URLs in .env) ---
# DATASOURCE_URL=jdbc:postgresql://your-postgres-host.rds.amazonaws.com:5432/drugstore_payments
# DB_USER=payment_service
# DB_PASSWORD=replace_with_secure_password
# REDIS_URL=redis://:replace_if_auth_enabled@your-redis-host.cache.amazonaws.com:6379
# STRIPE_API_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SWAGGER_ENABLED=false
# LOG_LEVEL_APP=INFO
# JAVA_OPTS=-Xmx768m -Xms512m -XX:+UseG1GC
