# ==========================================================
# Payment Service — shared Docker environment variables
# Copy to docker/.env and fill in required values.
# Profile-specific overrides live in .env.local / .env.prod.
# ==========================================================

# --- Required — Stripe ---
STRIPE_API_KEY=sk_test_replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret

# --- Required — Database ---
DB_PASSWORD=change-me
