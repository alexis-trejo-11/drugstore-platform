# ==========================================================
# Local profile — bundled containers (full stack) or host services (app only)
# Usage:
#   cp .env.example .env
#   cp .env.local.example .env.local
#   docker compose -f docker-compose.full.yml --profile local --env-file .env --env-file .env.local up -d --build
# ==========================================================

COMPOSE_PROFILES=local

# --- Database (full stack: Docker service name "postgres") ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DB_NAME=drugstore_payments
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- Host port mappings (full stack only, avoid conflicts with other services) ---
PAYMENT_SERVICE_HOST_PORT=8085
POSTGRES_HOST_PORT=5435
PROMETHEUS_HOST_PORT=9090
LOKI_HOST_PORT=3100
GRAFANA_HOST_PORT=3000

# --- Application tuning ---
SERVER_PORT=8080
SWAGGER_ENABLED=true
JAVA_OPTS=-Xmx512m -Xms256m

# --- Observability (local monitoring stack) ---
LOKI_PUSH_URL=http://loki:3100/loki/api/v1/push
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# --- App-only local profile: point to host or full-stack infra ---
# Uncomment when using docker-compose.app.yml against host-installed Postgres:
# POSTGRES_HOST=host.docker.internal
# POSTGRES_PORT=5432
# LOKI_PUSH_URL=http://host.docker.internal:3100/loki/api/v1/push
