# =============================================================================
# employee-service environment template
# -----------------------------------------------------------------------------
# Usage:
#   cp .env.example .env
#   # Set every REQUIRED variable below (no safe defaults in app/compose).
#   ./gradlew bootRun          # local JVM (profile: dev)
#   docker compose up -d --build
#
# Gradle loads ./.env for dependency resolution and bootRun (see build.gradle).
# Spring Boot imports ./.env via spring.config.import in application.yml.
# Docker Compose reads .env for ${VAR} substitution and passes it via env_file.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — GitHub Packages (local Gradle + docker compose build.args)
# Compose interpolates these into the image build; they are not baked into the runtime image.
# -----------------------------------------------------------------------------
GITHUB_ACTOR=
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# REQUIRED — JWT signing (≥32 characters for HS256)
# Local profile: JWT_SECRET + ISSUER
# Docker profile: JWT_SECRET_KEY + JWT_ISSUER (set all four to the same values)
# -----------------------------------------------------------------------------
JWT_SECRET=
JWT_SECRET_KEY=
ISSUER=
JWT_ISSUER=

# Optional JWT lifetimes (minutes) — defaults in application*.yml if unset
# JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
# JWT_REFRESH_TOKEN_EXPIRATION_MINUTES=43200

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# -----------------------------------------------------------------------------
# REQUIRED — Database credentials (application.yml + compose postgres)
# Non-secret names (DB_NAME / host / port) may use the examples below.
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
STORE_DB=employee_db
POSTGRES_USER=
POSTGRES_PASSWORD=

POSTGRES_DB_NAME=employee_db
POSTGRES_DB_USER=

DB_NAME=employee_db
DB_USER=
DB_PASSWORD=

# Pool sizing — docker profile only
# POSTGRES_MAX_POOL_SIZE=20
# POSTGRES_MIN_IDLE=5

# -----------------------------------------------------------------------------
# Redis — local dev (./gradlew bootRun)
# Docker Compose overrides SPRING_DATA_REDIS_HOST/PORT to redis:6379 in the container.
# -----------------------------------------------------------------------------
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# Used by application-docker.yml (compose sets REDIS_HOST=redis at runtime)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# REQUIRED for docker compose — API docs exposure
# -----------------------------------------------------------------------------
SWAGGER_ENABLED=false

# -----------------------------------------------------------------------------
# REQUIRED for docker compose — Grafana admin login
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Spring Cloud Config — docker profile
# -----------------------------------------------------------------------------
CONFIG_SERVER_ENABLED=false
CONFIG_SERVER_URI=http://config-server:8888
SPRING_CLOUD_CONFIG_ENABLED=false
SPRING_CLOUD_BOOTSTRAP_ENABLED=false

# -----------------------------------------------------------------------------
# Optional — Spring Boot Admin client (disabled by default; enable only with a real admin server)
# -----------------------------------------------------------------------------
# SPRING_BOOT_ADMIN_CLIENT_ENABLED=false
# SPRING_BOOT_ADMIN_URL=http://admin-service:8080
# SPRING_BOOT_ADMIN_SERVICE_URL=http://employee-service:8080

# -----------------------------------------------------------------------------
# Optional — rate limits, logging, observability (see application-docker.yml)
# -----------------------------------------------------------------------------
# RATE_LIMIT_GLOBAL_MAX=5000
# SPRING_APPLICATION_NAME=employee-service
# LOG_PATH=logs
# LOG_LEVEL_ROOT=INFO
# LOG_LEVEL_APP=DEBUG
# MANAGEMENT_HEALTH_DETAILS=always
