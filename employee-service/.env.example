# ==========================================================
# Employee Service — Environment Variables
# Copy to .env at this directory (project root) and fill in values.
#
# Docker (run from project root):
#   cp .env.example .env
#   docker compose -f docker/docker-compose.yml --env-file .env up -d --build
#   docker compose -f docker/docker-compose.yml  --env-file .env up -d --build
#
# Gradle also reads this file for GitHub Packages credentials.
# ==========================================================

# --- Required ---
JWT_SECRET_KEY=change_me_super_long_random_secret
GITHUB_ACTOR=your_github_username
GITHUB_TOKEN=ghp_your_personal_access_token

# --- Docker Compose profiles: pass --profile nginx | infra | observability on the CLI ---

# --- Spring / Docker runtime ---
# docker         → application-docker.yml (defaults: bundled service hostnames)

SPRING_PROFILES_ACTIVE=docker
EMPLOYEE_SERVICE_PORT=8081
JWT_ISSUER=drugstore-api

# --- Database (required) ---
# Full stack local: jdbc:postgresql://postgres:5432/employee_db
# App-only on host: jdbc:postgresql://host.docker.internal:5432/employee_db
# Local JVM (./gradlew bootRun): jdbc:postgresql://localhost:5432/employee_db
# Production: jdbc:postgresql://your-host:5432/your_db
DATASOURCE_URL=jdbc:postgresql://postgres:5432/employee_db
DB_USER=postgres
DB_PASSWORD=postgres

# Full stack only: bundled Postgres container init (local profile)
DB_NAME=employee_db

# --- Redis (required) ---
# Full stack local: redis://redis:6379
# App-only on host: redis://host.docker.internal:6379
# Local JVM: redis://localhost:6379
# With password: redis://:yourpassword@your-host:6379
REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=drugstore:employee:

# --- Optional: database pool ---
# DB_MAX_POOL_SIZE=20
# DB_MIN_IDLE=5

# --- Optional: Redis pool ---
# REDIS_POOL_MAX_ACTIVE=20
# REDIS_POOL_MAX_IDLE=10
# REDIS_POOL_MIN_IDLE=5

# --- Optional: application tuning ---
SWAGGER_ENABLED=true
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_ROOT=WARN
JAVA_OPTS=-Xmx512m -Xms256m

# --- Optional: JWT token lifetimes (minutes) ---
# JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
# JWT_REFRESH_TOKEN_EXPIRATION_MINUTES=43200

# --- Optional: rate limits ---
# RATE_LIMIT_GLOBAL_MAX=5000
# RATE_LIMIT_STANDARD=40
# RATE_LIMIT_SENSITIVE=7
# RATE_LIMIT_PUBLIC=100
# RATE_LIMIT_ADMIN=50
# RATE_LIMIT_CUSTOMER_WRITE=20
# RATE_LIMIT_CUSTOMER_READ=100

# --- Optional: logging / Loki ---
# Docker full stack:  http://loki:3100/loki/api/v1/push
# Local Loki on host: http://localhost:3100/loki/api/v1/push
# AWS / Grafana Cloud: https://logs-prod-xxx.grafana.net/loki/api/v1/push
LOKI_PUSH_URL=http://loki:3100/loki/api/v1/push
# LOKI_ENV=local|docker|prod

# --- Optional: logging ---
# bootRun defaults to ./logs; Docker sets LOG_PATH=/app/logs via compose. Override only if needed.
# LOG_PATH=./logs
# LOG_MAX_SIZE=100MB
# LOG_MAX_HISTORY=30
# LOG_LEVEL_SPRING_WEB=WARN
# LOG_LEVEL_SPRING_SECURITY=WARN
# LOG_LEVEL_HIBERNATE=WARN
# LOG_LEVEL_AUDIT=INFO
# AUDIT_DETAILED=false

# --- Optional: management / config server ---
# MANAGEMENT_HEALTH_DETAILS=always
# CONFIG_SERVER_ENABLED=false
# CONFIG_SERVER_URI=http://config-server:8888

# --- Full stack only: host port mappings (avoid conflicts with other services) ---
POSTGRES_HOST_PORT=5431
REDIS_HOST_PORT=6378
PROMETHEUS_HOST_PORT=9090
LOKI_HOST_PORT=3100
GRAFANA_HOST_PORT=3000

# --- Full stack only: Grafana admin (local monitoring) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Production overrides (set cloud URLs in .env, run without --profile infra) ---
# DATASOURCE_URL=jdbc:postgresql://your-postgres-host.rds.amazonaws.com:5432/employee_db
# DB_USER=employee_service
# DB_PASSWORD=replace_with_secure_password
# REDIS_URL=redis://:replace_if_auth_enabled@your-redis-host.cache.amazonaws.com:6379
# SWAGGER_ENABLED=false
# LOG_LEVEL_APP=INFO
# JAVA_OPTS=-Xmx768m -Xms512m -XX:+UseG1GC
