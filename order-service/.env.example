# Local / Docker Compose environment for order-service
# Copy to ".env" in this directory (gitignored). Docker Compose loads .env automatically.
# Do not commit real secrets.

# --- Required for docker profile (docker-compose) ---
# HS256-compatible secret; use a long random string (32+ bytes). No default in compose.
JWT_SECRET_KEY=

# --- Database (used by compose variable substitution for postgres + order-service) ---
DB_NAME=order_db
DB_USER=postgres
# Set a strong password for anything beyond disposable local dev.
DB_PASSWORD=

# --- Optional (docker / Spring overrides) ---
# Published host port for order-service (container still listens on 8080 via SERVER_PORT in compose).
ORDER_SERVICE_HOST_PORT=8086
JWT_ISSUER=order-service
SWAGGER_ENABLED=true

# Rate limits (application-docker.yml); omit to use YAML defaults
# RATE_LIMIT_STANDARD=40
# RATE_LIMIT_SENSITIVE=7
# RATE_LIMIT_PUBLIC=100
# RATE_LIMIT_ADMIN=50
# RATE_LIMIT_CUSTOMER_READ=100
# RATE_LIMIT_CUSTOMER_WRITE=20
# RATE_LIMIT_GLOBAL_MAX=5000
