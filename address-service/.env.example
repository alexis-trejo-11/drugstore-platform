# ==========================================================
# Address Service - Environment Variables Example
# Copy this file to `.env` and update values as needed.
# ==========================================================

# --- Required ---
JWT_SECRET_KEY=change_me_super_long_random_secret
ISSUER=drugstore-api

# --- GitHub Packages (Gradle dependency resolution) ---
GITHUB_ACTOR=your_github_username
GITHUB_TOKEN=ghp_your_personal_access_token

# --- Common local overrides ---
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Docker profile ---
DB_USER=postgres
DB_PASSWORD=postgres

# --- Common docker overrides ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=address_db
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

SERVER_PORT=8080
ADDRESS_SERVER_PORT=8080


# --- Github Package ---
GITHUB_ACTOR=username...
GITHUB_TOKEN=ghp_...