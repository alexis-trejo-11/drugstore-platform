# ==========================================================
# Address Service — Environment Variables
# Copy to .env at this directory (project root) and fill in values.
#
# Docker (from this directory):
#   cp .env.example .env
#   docker compose up -d --build
#   # Full guide: docs/docker-local-dev.md (repo root)
#

# Gradle also reads this file for GitHub Packages credentials.
# ==========================================================

# --- Required ---
JWT_SECRET_KEY=change_me_super_long_random_secret
GITHUB_ACTOR=your_github_username
GITHUB_TOKEN=ghp_your_personal_access_token
ADDRESS_SERVICE_PORT=8069

# --- App container joins external networks; infra is shared outside this repo ---

# --- Spring profile — only for the app container (Compose / Dockerfile) ---
# docker       → application-docker.yml (defaults: postgres, redis service hostnames)
# (unset)      → application.yml standalone defaults (localhost); used by ./gradlew bootRun
SPRING_PROFILES_ACTIVE=docker
JWT_ISSUER=drugstore-api

# --- Database (required for Docker; bootRun uses localhost defaults if unset) ---
# Standalone bootRun / IDE: jdbc:postgresql://localhost:5432/drugstore_addresses (default in application.yml)
# Shared infra hostname (example): jdbc:postgresql://postgres_central:5432/your_db
# App-only on host:         jdbc:postgresql://host.docker.internal:5432/address_db
# Production:               jdbc:postgresql://your-host:5432/your_db
DATASOURCE_URL=jdbc:postgresql://postgres:5432/address_db
DB_USER=postgres
DB_PASSWORD=postgres

DB_NAME=address_db

# --- Redis (required for Docker; bootRun uses localhost default if unset) ---
# Standalone bootRun / IDE: redis://localhost:6379 (default in application.yml)
# Shared infra hostname (example): jdbc:postgresql://postgres_central:5432/your_db
# App-only on host:         redis://host.docker.internal:6379
# With password:            redis://:yourpassword@your-host:6379
# Redis Cloud shared instance: set REDIS_URL to your cloud endpoint
REDIS_URL=redis://redis:6379
# Namespace all keys from this service (rate limits, caches). Change only if you run multiple envs on one Redis.
REDIS_KEY_PREFIX=drugstore:address:

# --- Optional: database pool ---
# DB_MAX_POOL_SIZE=20
# DB_MIN_IDLE=5

# --- Optional: Redis pool ---
# REDIS_POOL_MAX_ACTIVE=20
# REDIS_POOL_MAX_IDLE=10
# REDIS_POOL_MIN_IDLE=5

# --- Optional: application tuning ---
SWAGGER_ENABLED=true
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_ROOT=WARN
JAVA_OPTS=-Xmx512m -Xms256m

# --- Optional: JWT token lifetimes (minutes) ---
# JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
# JWT_REFRESH_TOKEN_EXPIRATION_MINUTES=43200

# --- Optional: rate limits ---
# RATE_LIMIT_GLOBAL_MAX=5000
# RATE_LIMIT_STANDARD=40
# RATE_LIMIT_SENSITIVE=7
# RATE_LIMIT_PUBLIC=100
# RATE_LIMIT_ADMIN=50
# RATE_LIMIT_CUSTOMER_WRITE=20
# RATE_LIMIT_CUSTOMER_READ=100

# LOG_LEVEL_SPRING_WEB=WARN
# LOG_LEVEL_SPRING_SECURITY=WARN
# LOG_LEVEL_HIBERNATE=WARN
# LOG_LEVEL_AUDIT=INFO
# AUDIT_DETAILED=false

# --- Optional: management / config server ---
# MANAGEMENT_HEALTH_DETAILS=always
# CONFIG_SERVER_ENABLED=false
# CONFIG_SERVER_URI=http://config-server:8888

# --- Full stack only: Grafana admin (local monitoring) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Production / shared-infra overrides (set cloud or central host URLs in .env) ---
# DATASOURCE_URL=jdbc:postgresql://your-postgres-host.rds.amazonaws.com:5432/address_db
# DB_USER=address_service
# DB_PASSWORD=replace_with_secure_password
# REDIS_URL=redis://:replace_if_auth_enabled@your-redis-host.cache.amazonaws.com:6379
# SWAGGER_ENABLED=false
# LOG_LEVEL_APP=INFO
# JAVA_OPTS=-Xmx768m -Xms512m -XX:+UseG1GC
