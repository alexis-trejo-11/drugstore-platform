# User Service environment example
# Copy this file to `.env` in `user-service/` and adjust values.

# Runtime
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080
USER_SERVER_PORT=8080
ORDER_SERVICE_HOST_PORT=8086
DEBUG_MODE=true

# Admin / config
BOOT_ADMIN_URL=http://localhost:8080
BOOT_ADMIN_SERVICE_URL=http://localhost:8080
CONFIG_SERVER_ENABLED=false
CONFIG_SERVER_URI=http://config-server:8888

# Database
DB_NAME=user_db
DB_USER=postgres
DB_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB_NAME=user_db
POSTGRES_DB_USER=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
product_DB=drugstore_products
POSTGRES_MAX_POOL_SIZE=20
POSTGRES_MIN_IDLE=5

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_POOL_MAX_ACTIVE=20
REDIS_POOL_MAX_IDLE=10
REDIS_POOL_MIN_IDLE=5
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=redispass

# Kafka
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=user-service-group
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=false
KAFKA_MAX_POLL_RECORDS=10
KAFKA_FETCH_MIN_BYTES=1
KAFKA_FETCH_MAX_WAIT_MS=500
KAFKA_SESSION_TIMEOUT_MS=30000
KAFKA_HEARTBEAT_INTERVAL_MS=3000
KAFKA_CONCURRENCY=3
KAFKA_TRUSTED_PACKAGES=*
KAFKA_TOPIC_USER_CREATED=user.created
KAFKA_TOPIC_USER_UPDATED=user.updated
KAFKA_TOPIC_USER_DELETED=user.deleted

# JWT / security
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_SECRET=replace_with_a_long_random_secret
JWT_ISSUER=user-service
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_MINUTES=43200
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000
JWT_ACTIVATION_TOKEN_EXPIRATION_MS=86400000
JWT_INCLUDE_IP=true
JWT_INCLUDE_USER_AGENT=true
JWT_REFRESH_TOKEN_REUSABLE=false

# Token / 2FA / rate limits
TOKEN_ACTIVATION_LENGTH=6
TOKEN_ACTIVATION_EXPIRATION=300000
TOKEN_ACTIVATION_ALLOWED_ATTEMPTS=3
TOKEN_ACTIVATION_BLOCK_TIME=300000
TOKEN_2FA_LENGTH=6
TOKEN_2FA_EXPIRATION=120000
TOKEN_2FA_ALLOWED_ATTEMPTS=3
TOKEN_2FA_BLOCK_TIME=600000
TOKEN_PASSWORD_RESET_LENGTH=8
TOKEN_PASSWORD_RESET_EXPIRATION=3600000
TOKEN_PASSWORD_RESET_SPECIAL_CHARS=true
TOKEN_EMAIL_VERIFICATION_LENGTH=6
TOKEN_EMAIL_VERIFICATION_EXPIRATION=300000
TOKEN_SECURITY_MAX_TOKENS_PER_USER=5
TOKEN_SECURITY_CLEANUP_INTERVAL=300000
TOKEN_SECURITY_ENCRYPTION_ENABLED=false
TWO_FA_SECRET_LENGTH=32
TWO_FA_SECRET_ALGORITHM=HmacSHA1
TWO_FA_SECRET_TIME_STEP=30
TWO_FA_SECRET_DIGITS=6
TWO_FA_SECRET_WINDOW=1
TWO_FA_BACKUP_CODES_COUNT=5
TWO_FA_BACKUP_CODES_LENGTH=8
TWO_FA_BACKUP_CODES_EXPIRATION=15778463000
RATE_LIMIT_TOKEN_GENERATION_MAX_ATTEMPTS=10
RATE_LIMIT_TOKEN_GENERATION_TIME_WINDOW=3600000
RATE_LIMIT_TOKEN_VALIDATION_MAX_ATTEMPTS=20
RATE_LIMIT_TOKEN_VALIDATION_TIME_WINDOW=3600000
RATE_LIMIT_GLOBAL_MAX=5000
RATE_LIMIT_STANDARD=40
RATE_LIMIT_SENSITIVE=7
RATE_LIMIT_PUBLIC=100
RATE_LIMIT_ADMIN=50
RATE_LIMIT_CUSTOMER_WRITE=20
RATE_LIMIT_CUSTOMER_READ=100

# gRPC
GRPC_PORT=9090
GRPC_SECURITY_ENABLED=false
GRPC_MAX_INBOUND_MESSAGE_SIZE=4MB
GRPC_MAX_INBOUND_METADATA_SIZE=8KB

# Docs / logs
SWAGGER_ENABLED=true
LOG_PATH=/app/logs
LOG_MAX_SIZE=100MB
LOG_MAX_HISTORY=30
LOG_LEVEL_ROOT=WARN
LOG_LEVEL_APP=INFO
LOG_LEVEL_SPRING_WEB=WARN
LOG_LEVEL_SPRING_SECURITY=WARN
LOG_LEVEL_HIBERNATE=WARN
LOG_LEVEL_AUDIT=INFO
AUDIT_DETAILED=false
MANAGEMENT_HEALTH_DETAILS=always

